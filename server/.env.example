# Copiez ce fichier en « .env », puis remplissez les trois premières lignes.

# Clé de l'API Anthropic (console.anthropic.com → API keys). Elle reste sur ce serveur.
ANTHROPIC_API_KEY=

# Secret commun avec l'application (au moins 24 caractères). Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La même valeur va dans le fichier .env de l'application (EXPO_PUBLIC_ASSISTANT_TOKEN).
# Il ne sert qu'à ouvrir la session d'un appareil.
LIORA_APP_TOKEN=

# Secret connu du serveur seul (au moins 32 caractères, différent du précédent).
# Générez-le avec la même commande. Il signe les sessions des appareils :
# le changer déconnecte tous les appareils, qui rouvrent une session d'eux-mêmes.
LIORA_SESSION_SECRET=

# --- Hébergement ---
# Nombre de serveurs intermédiaires de confiance devant le relais.
# 0 si le relais est joint directement ; 1 chez la plupart des hébergeurs (Render, Railway, Fly…).
# LIORA_TRUST_PROXY=0
# PORT=8787
# HOST=0.0.0.0
# Sites web autorisés à appeler le serveur (aperçu web de l'application), séparés par des virgules.
# LIORA_ALLOWED_ORIGINS=http://localhost:8081

# --- Plafonds de dépense ---
# Redis REST (Upstash) : obligatoire avec NODE_ENV=production.
# Utilisez la même base pour toutes les instances. Ne pas activer l'éviction des clés.
# LIORA_REDIS_REST_URL=https://votre-base.upstash.io
# LIORA_REDIS_REST_TOKEN=
# Sans ces variables, les compteurs en mémoire sont réservés au développement.
# Par appareil et par jour.
# LIORA_ASSISTANT_PER_DAY=150
# LIORA_MOOD_PER_DAY=20
# Tous appareils réunis, par jour : le coupe-circuit de la facture.
# LIORA_GLOBAL_PER_DAY=5000
# Par appareil et par minute.
# LIORA_ASSISTANT_PER_MINUTE=30
# LIORA_MOOD_PER_MINUTE=6
# LIORA_NEWS_PER_MINUTE=20
# Demandes de session par adresse et par heure.
# LIORA_SESSIONS_PER_HOUR=20

# --- Divers ---
# Durée d'une session d'appareil, en jours.
# LIORA_SESSION_DAYS=30
# Appareils à bloquer (identifiants séparés par des virgules).
# LIORA_BLOCKED_DEVICES=
# LIORA_MODEL=claude-opus-5-5
# LIORA_EFFORT=medium
