# Copiez ce fichier en « .env » pour relier l'application à son serveur.
# Sans ces deux lignes, l'application fonctionne normalement, sans l'assistant ni le scan du visage.
# Les actualités sont alors lues directement auprès des sources.

# Adresse du serveur relais (dossier « server »).
# Pendant les essais : l'adresse de votre ordinateur sur le Wi-Fi, par exemple http://192.168.1.20:8787
# En production : une adresse https obligatoirement.
EXPO_PUBLIC_ASSISTANT_URL=

# Même valeur que LIORA_APP_TOKEN dans le fichier .env du serveur.
EXPO_PUBLIC_ASSISTANT_TOKEN=

# Service d'envoi de l'e-mail « mot de passe oublié » (facultatif).
# EXPO_PUBLIC_PASSWORD_RESET_URL=

# Contenu d'exemple à la création d'un compte : activé pendant le développement,
# désactivé dans une application publiée. « true » ou « false » force le choix.
# EXPO_PUBLIC_DEMO_DATA=
